#!/bin/sh
# pre-push: full quality gate before sharing commits.
# Runs clippy with -D warnings (blocks new debt) and the full test suite.
# Heavier than pre-commit; only triggers on push to keep day-to-day commits fast.

export PATH="$HOME/.cargo/bin:$PATH"

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "[pre-push] running clippy (-D warnings)..."
if ! cargo clippy --workspace --all-targets -- -D warnings; then
  echo ""
  echo "[pre-push] FAIL: clippy found warnings. Fix them or the push is blocked."
  exit 1
fi

echo "[pre-push] running tests..."
if ! cargo test --workspace --quiet; then
  echo ""
  echo "[pre-push] FAIL: tests failed. Fix failures before pushing."
  exit 1
fi

echo "[pre-push] OK (clippy + tests)"
