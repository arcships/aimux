{
  "description": "Host-side tool-call repair (RFC-0035). Every case is pure: feed `input`, expect `expected` (deep-equal) or the named `expected_error` variant. `prompt` and `opts` are the SAME values the call was generated with; a host serializes them to JSON strings before passing them. A `null` `opts` means defaults. An `expected` of null is the literal JSON null the context function writes for a call made without a tool set.",
  "cases": [
    {
      "name": "context_string_prompt",
      "function": "tool_call_repair_context",
      "description": "A bare string prompt becomes the single user message the model saw; `instructions` comes from the options, not from the prompt.",
      "input": {
        "tool_call": {
          "tool_call_id": "call-1",
          "tool_name": "weather",
          "input": {
            "town": "Singapore"
          },
          "dynamic": true,
          "invalid": true,
          "error": {
            "InvalidToolInput": {
              "tool_name": "weather",
              "tool_input": "{\"town\":\"Singapore\"}",
              "cause": "Type validation failed: Value: {\"town\":\"Singapore\"}.\nError message: Additional properties are not allowed ('town' was unexpected)"
            }
          }
        },
        "prompt": "weather in Singapore?",
        "opts": {
          "tools": [
            {
              "type": "function",
              "name": "weather",
              "input_schema": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string"
                  }
                },
                "required": [
                  "city"
                ],
                "additionalProperties": false
              }
            }
          ],
          "instructions": "be terse"
        }
      },
      "expected": {
        "tool_call": {
          "tool_call_id": "call-1",
          "tool_name": "weather",
          "input": "{\"town\":\"Singapore\"}",
          "dynamic": true
        },
        "error": {
          "InvalidToolInput": {
            "tool_name": "weather",
            "tool_input": "{\"town\":\"Singapore\"}",
            "cause": "Type validation failed: Value: {\"town\":\"Singapore\"}.\nError message: Additional properties are not allowed ('town' was unexpected)"
          }
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ],
          "additionalProperties": false
        },
        "tools": [
          {
            "type": "function",
            "name": "weather",
            "input_schema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ],
              "additionalProperties": false
            }
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": "weather in Singapore?"
          }
        ],
        "instructions": "be terse"
      }
    },
    {
