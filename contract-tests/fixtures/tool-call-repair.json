    {
      "name": "reply_repaired_validates",
      "function": "apply_tool_call_repair",
      "description": "A replacement that satisfies the schema yields a valid tool call: no `invalid`, no `error`, no `dynamic`.",
      "input": {
        "tool_call": {
          "tool_call_id": "call-1",
          "tool_name": "weather",
          "input": {
            "town": "Singapore"
          },
          "dynamic": true,
          "invalid": true,
          "error": {
            "InvalidToolInput": {
              "tool_name": "weather",
              "tool_input": "{\"town\":\"Singapore\"}",
              "cause": "Type validation failed: Value: {\"town\":\"Singapore\"}.\nError message: Additional properties are not allowed ('town' was unexpected)"
            }
          }
        },
        "opts": {
          "tools": [
            {
              "type": "function",
              "name": "weather",
              "input_schema": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string"
                  }
                },
                "required": [
                  "city"
                ],
                "additionalProperties": false
              }
            }
          ],
          "instructions": "be terse"
        },
        "reply": {
          "type": "repaired",
          "tool_call": {
            "tool_call_id": "call-1",
            "tool_name": "weather",
            "input": "{\"city\":\"Singapore\"}"
          }
        }
      },
      "expected": {
        "tool_call_id": "call-1",
        "tool_name": "weather",
        "input": {
          "city": "Singapore"
        }
      }
    },
    {
      "name": "reply_repaired_still_invalid",
      "function": "apply_tool_call_repair",
      "description": "A replacement that still fails validation keeps the ORIGINAL call and reports ToolCallRepair{original_error, cause}.",
      "input": {
        "tool_call": {
          "tool_call_id": "call-1",
          "tool_name": "weather",
          "input": {
            "town": "Singapore"
          },
          "dynamic": true,
          "invalid": true,
          "error": {
            "InvalidToolInput": {
              "tool_name": "weather",
              "tool_input": "{\"town\":\"Singapore\"}",
              "cause": "Type validation failed: Value: {\"town\":\"Singapore\"}.\nError message: Additional properties are not allowed ('town' was unexpected)"
            }
          }
        },
        "opts": {
          "tools": [
            {
              "type": "function",
              "name": "weather",
              "input_schema": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string"
                  }
                },
                "required": [
                  "city"
                ],
                "additionalProperties": false
              }
            }
          ],
          "instructions": "be terse"
        },
        "reply": {
          "type": "repaired",
          "tool_call": {
            "tool_call_id": "call-1",
            "tool_name": "weather",
            "input": "{\"city\":42}"
          }
        }
      },
      "expected": {
        "tool_call_id": "call-1",
        "tool_name": "weather",
        "input": {
          "town": "Singapore"
        },
        "dynamic": true,
        "invalid": true,
        "error": {
          "ToolCallRepair": {
            "original_error": {
              "InvalidToolInput": {
                "tool_name": "weather",
                "tool_input": "{\"town\":\"Singapore\"}",
                "cause": "Type validation failed: Value: {\"town\":\"Singapore\"}.\nError message: Additional properties are not allowed ('town' was unexpected)"
              }
            },
            "cause": {
              "InvalidToolInput": {
                "tool_name": "weather",
                "tool_input": "{\"city\":42}",
                "cause": "Type validation failed: Value: {\"city\":42}.\nError message: 42 is not of type \"string\""
              }
            }
          }
        }
      }
    },
