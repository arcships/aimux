{
  "name": "@arcships/aimux",
  "version": "0.1.1",
  "description": "Unified LLM service layer — one API for 172+ AI providers (Rust core, Node.js binding)",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "dist/",
    "*.node"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arcships/aimux.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./raw": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "napi": {
    "name": "aimux",
    "package": {
      "name": "@arcships/aimux"
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:typed": "tsc -p tsconfig.json",
    "test": "ava",
    "prepublishOnly": "npm run build:typed && napi prepublish -t npm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.0",
    "ava": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "license": "MIT"
}
