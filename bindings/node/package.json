{
  "name": "@arcships/aimux",
  "version": "0.5.0",
  "description": "Unified LLM service layer — one API for 325 AI providers (Rust core, Node.js binding)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arcships/aimux.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./raw": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./package.json": "./package.json"
  },
  "napi": {
    "binaryName": "aimux",
    "packageName": "@arcships/aimux",
    "dtsHeader": "/* auto-generated by NAPI-RS */\n/* eslint-disable */\nexport type WireResult<T> = T\n",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:typed": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test __test__/*.test.ts __test__/*.native.ts __test__/*.spec.ts",
    "prepublishOnly": "npm run build:typed && napi prepublish -t npm --no-gh-release",
    "test:native": "node --experimental-strip-types --test __test__/*.native.ts",
    "test:facade": "node --experimental-strip-types --test __test__/*.test.ts",
    "test:lifecycle": "node --experimental-strip-types --test __test__/event_loop.spec.ts",
    "test:c-parity": "node --experimental-strip-types --test __test__/abi.parity.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "license": "MIT"
}
